 "segmentos": [
  {
   "tag": "la trampa",
   "sub": "Mucha gente dice que la *DCT* comprime la imagen. Y no: la DCT por sí sola no pierde *nada*.",
   "titulo": "LA DCT *NO PIERDE*",
   "visual": {
    "tipo": "pregunta",
    "pregunta": "¿Dónde pierde JPEG la calidad?",
    "opciones": [
     "En la DCT",
     "Al dividir por la tabla",
     "En el Huffman"
    ],
    "correcta": 1,
    "en": "nada."
   }
  },
  {
   "tag": "reversible",
   "sub": "Se puede deshacer entera: con la DCT inversa recuperas el bloque *idéntico*. Es solo un cambio de idioma.",
   "titulo": "SE PUEDE *DESHACER*",
   "visual": {
    "tipo": "alerta",
    "icono": "🔄",
    "linea1": "DCT inversa → mismo bloque",
    "linea2": "REVERSIBLE"
   }
  },
  {
   "tag": "la pérdida",
   "sub": "La pérdida está en la máscara, al redondear. Y de ahí salen *dos* efectos.",
   "titulo": "DOS *EFECTOS*",
   "visual": {
    "tipo": "alerta",
    "icono": "🔍",
    "linea1": "Pérdida = máscara",
    "linea2": "DOS EFECTOS"
   }
  },
  {
   "tag": "efecto uno",
   "sub": "Uno: *borrosidad*. Al tirar las frecuencias altas, los bordes finos se suavizan.",
   "titulo": "EFECTO 1: *BORROSO*",
   "visual": {
    "tipo": "alerta",
    "icono": "🌫️",
    "linea1": "Se pierden frecuencias altas",
    "linea2": "IMAGEN BLANDA"
   }
  },
  {
   "tag": "efecto dos",
   "sub": "Dos: *bloques*. Cada trozo de ocho por ocho va por su cuenta, y entre vecinos se nota el salto.",
   "titulo": "EFECTO 2: *BLOQUES*",
   "visual": {
    "tipo": "alerta",
    "icono": "🧱",
    "linea1": "Cada bloque 8×8 va por libre",
    "linea2": "CUADRÍCULA VISIBLE"
   }
  },
  {
   "tag": "la medida",
   "sub": "Por eso un defecto de dieciséis por dieciséis píxeles son *cuatro bloques*: dos por dos. Siempre múltiplos de ocho.",
   "titulo": "MÚLTIPLOS DE *8*",
   "visual": {
    "tipo": "calculo",
