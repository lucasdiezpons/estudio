  {
   "tag": "la I",
   "sub": "La *I* es la foto entera: un JPEG de toda la vida. Se entiende ella sola.",
   "titulo": "I = *FOTO*",
   "visual": {
    "tipo": "alerta",
    "icono": "📷",
    "linea1": "Un JPEG por sí sola",
    "linea2": "NO DEPENDE DE NADIE"
   }
  },
  {
   "tag": "la P",
   "sub": "La *P* dice: es como la anterior, pero esto se movió así. Solo guarda la *diferencia*.",
   "titulo": "P = *PARCHE*",
   "visual": {
    "tipo": "alerta",
    "icono": "🩹",
    "linea1": "Mira hacia atrás",
    "linea2": "GUARDA LA DIFERENCIA"
