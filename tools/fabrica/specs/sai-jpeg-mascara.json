    ]
   }
  },
  {
   "tag": "ejemplo dos",
   "sub": "Menos doce entre diez, menos uno coma dos... *menos uno*.",
   "titulo": "−12 ÷ 10 = *−1*",
   "visual": {
    "tipo": "calculo",
    "lineas": [
     {
      "txt": "−12 ÷ 10 = −1,2"
