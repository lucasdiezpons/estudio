 "_guion": {
  "frase_clave": "En un GoP con N=15 y M=3 hay 1 I, 4 P y 10 B; media ponderada de tamaños × imágenes por segundo = 1,4 Mbit/s.",
  "ganchos": [
   "¿Cuántos megabits genera un MPEG? Cuenta las I, P y B de un GoP.",
   "Una media ponderada y listo.",
   "Quince imágenes: ¿cuántas son I, P y B?"
  ],
  "elegido": 0
 },
 "segmentos": [
  {
   "tag": "el reto",
   "sub": "Tienes N igual a quince, M igual a tres. ¿Cuántas I, P y B hay en cada grupo? Eso decide *el caudal*.",
   "titulo": "CUENTA *I P B*",
   "visual": {
    "tipo": "alerta",
    "icono": "🧮",
    "linea1": "N = 15 · M = 3",
    "linea2": "¿CUÁNTAS DE CADA?"
   }
  },
  {
   "tag": "las P",
   "sub": "Una I por grupo. Y de P: quince entre tres, menos uno... *cuatro*.",
   "titulo": "P = N/M − *1*",
   "visual": {
    "tipo": "calculo",
    "lineas": [
     {
      "txt": "15 ÷ 3 − 1"
     },
     {
      "txt": "= 4 P"
     }
    ]
   }
  },
  {
   "tag": "las B",
   "sub": "Las B son las que sobran: quince menos una, menos cuatro... *diez*.",
   "titulo": "B = *10*",
   "visual": {
    "tipo": "calculo",
    "lineas": [
     {
      "txt": "15 − 1 − 4"
     },
     {
      "txt": "= 10 B"
     }
    ]
   }
  },
  {
   "tag": "la media",
   "sub": "Ahora la media: I catorce mil cuatrocientos, P siete mil seiscientos, B cuatro mil trescientos, cada una con su *peso*.",
   "titulo": "MEDIA *PONDERADA*",
   "visual": {
    "tipo": "calculo",
    "lineas": [
     {
      "txt": "14 442 · 1/15"
     },
     {
      "txt": "+ 7 595 · 4/15"
     },
     {
      "txt": "+ 4 311 · 10/15"
     }
    ]
   }
  },
  {
   "tag": "el resultado",
   "sub": "Salen cinco mil ochocientos sesenta y dos bytes por imagen: a veintinueve coma noventa y siete, *uno coma cuatro* megabits.",
   "titulo": "1,4 *Mbit/s*",
   "visual": {
    "tipo": "calculo",
    "lineas": [
     {
      "txt": "5 862 B × 8 = 46 897 bits"
     },
     {
      "txt": "× 29,97 im/s"
     },
     {
      "txt": "≈ 1,405 Mbit/s"
     }
    ]
   }
  },
